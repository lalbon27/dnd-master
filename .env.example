PORT=3000

# Бесплатный ключ: console.groq.com/keys (без карты). Без него мастер отвечает шаблонными фразами.
GROQ_API_KEY=

# Опционально: портрет персонажа по селфи (Cloudflare Workers AI, бесплатно 10к нейронов/день, без карты).
# dash.cloudflare.com -> Workers AI -> Use REST API -> Create a Workers AI API Token (право Workers AI Edit).
# Без этих двух переменных портрет всё равно сгенерируется, но без переноса лица с фото.
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Голос мастера — Piper TTS (открытый, бесплатно, без ключей, без блокировок по стране).
# Бинарник и голос качаются сами при `npm install` (см. scripts/setup-piper.sh).
# Не требует переменных окружения для работы. Ниже — необязательный тюнинг подачи речи:
# PIPER_VOICE=ru_RU-denis-medium   # denis | dmitri | irina | ruslan (см. huggingface.co/rhasspy/piper-voices)
# PIPER_LENGTH_SCALE=1.15          # >1 — медленнее и размереннее ("сказительная" подача)
# PIPER_NOISE_SCALE=0.6
# PIPER_NOISE_W=0.8
