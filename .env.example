PORT=3000

# Бесплатный ключ: console.groq.com/keys (без карты). Без него мастер отвечает шаблонными фразами.
GROQ_API_KEY=

# Опционально: портрет персонажа по селфи (Cloudflare Workers AI, бесплатно 10к нейронов/день, без карты).
# dash.cloudflare.com -> Workers AI -> Use REST API -> Create a Workers AI API Token (право Workers AI Edit).
# Без этих двух переменных портрет всё равно сгенерируется, но без переноса лица с фото.
CF_ACCOUNT_ID=
CF_API_TOKEN=
